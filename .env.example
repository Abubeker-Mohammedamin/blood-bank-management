# Server configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
AUTH_SESSION_SECRET=GENERATE_A_RANDOM_SECRET_WITH_AT_LEAST_32_BYTES
# Comma-separated organization-approved codes; blank intentionally blocks unit release.
BLOOD_UNIT_REQUIRED_TEST_TYPES=
INVENTORY_LOW_STOCK_THRESHOLDS=
INVENTORY_EXPIRY_WARNING_DAYS=
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/blood_bank_test?schema=public

# PostgreSQL database used by Prisma.
# Create a dedicated database role and database before starting the app.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/blood_bank?schema=public
